{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crownos-landing-page",
  "compatibility_date": "2026-09-28",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
