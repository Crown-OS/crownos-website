{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crownos-website-v1",
  "compatibility_date": "2026-09-28",
  "routes": [{ "pattern": "v1.crownos.org", "custom_domain": true }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
